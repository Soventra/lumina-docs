DOCS_AI_API_KEY=your-dedicated-docs-virtual-key
# Defaults to https://gateway.lumina-sandbox.ai
# DOCS_AI_BASE_URL=https://your-gateway.example.com
# Public deployments also require DOCS_AI_PUBLIC_ENABLED=true
# DOCS_ORIGIN=https://docs.lumina.ai

# Workshop signup relay. Configure this server-only in Vercel; never expose it
# through Docusaurus customFields or a client-side environment variable.
# WORKSHOP_ZAPIER_WEBHOOK_URL=

# Optional: send Ask AI traces directly to standalone Lens.
# Copy a dedicated ingestion key from Lens Home > Tracing key.
# LUMINA_TRACING_KEY=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://your-lens.example.com/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# LENS_UI_URL=https://your-lens.example.com/ui/
# Optional dedicated tracing key for the authenticated Slack bot route.
# Uses the same Lens endpoint and agent name as website Ask AI.
# DOCS_BOT_TRACING_KEY=
